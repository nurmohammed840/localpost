{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.dart_tool": true,
        "**/.DS_Store": true,
        "**/.idea": true,
        "**/Thumbs.db": true,
        "**/flutter/ephemeral": true,
        "**/Flutter/ephemeral": true,
        "**/.symlinks": true,
        "**/.plugin_symlinks": true,
        //      
        "target": true,
        "**/*.lock": true,
        ".gitattributes": true,
        //
        "app/.flutter-plugins-dependencies": true,
        "app/.metadata": true,
        "app/flutter_rust_bridge.yaml": true,
        "app/analysis_options.yaml": true,
        "app/rust/src/frb_generated.rs": true,
        "app/rust/cargokit.yaml": true,
        "app/localpost.iml": true,
        //
        "app/build": true,
        "app/android": true,
        "app/windows": true,
        "app/linux": true,
        "app/rust_builder": true,
        //
        "app/lib/src": true,
    }
}